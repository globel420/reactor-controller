# Reactor runtime selector. Change only this value to switch stacks.
# Valid values: simulation, hardware
COMPOSE_PROFILES=simulation

# Hardware host paths. The hardware profile maps these to the fixed container
# paths /dev/sensor_arduino and /dev/pump_arduino. Startup fails if either host
# path is missing. These values are ignored by simulation.
SENSOR_DEVICE_HOST=/dev/sensor_arduino
PUMP_DEVICE_HOST=/dev/pump_arduino

# Exact USB serial identities used to generate deterministic UDEV symlinks.
# Find them with: udevadm info --query=property --name=/dev/ttyACM0
MEGA_USB_SERIAL=REPLACE_WITH_MEGA_SERIAL
UNO_USB_SERIAL=REPLACE_WITH_UNO_SERIAL

# Raspberry Pi alarm relay. Mock GPIO is forced on by the simulation profile;
# hardware defaults to false so missing GPIO access cannot be reported as real.
PI_BUZZER_GPIO=26
ALLOW_MOCK_GPIO=false
HOST_SAFETY_LATCH_FILE=data/hardware/safety_latched

# Field hotspot settings used by setup_pi.sh. Replace the password before
# provisioning; it is stored only in ignored .env with restrictive permissions.
HOTSPOT_SSID=Reactor-Rig
HOTSPOT_PSK=REPLACE_WITH_UNIQUE_WPA2_PASSWORD

# Arduino Mega 2560 pin map. Keep this file aligned with the physical wiring
# before building/flashing firmware. SPI_SCK/SPI_MISO below are the software
# SPI bus for the two MAX31855 channels; the MAX31865 board uses the Mega's
# fixed hardware SPI pins 50-52, which cannot be remapped in this file.
MEGA_PIN_SPI_SCK=7
MEGA_PIN_SPI_MISO=5
MEGA_PIN_TC_FEED_RES=38
MEGA_PIN_TC_HOUSING=36
MEGA_PIN_RTD_PREHEATER=40
MEGA_PIN_RTD_LIQUID=42
MEGA_PIN_RTD_GAS_INT=44
MEGA_PIN_RTD_GAS_EXT=46
MEGA_PIN_H2_SENSOR=A0
MEGA_PIN_HX711_SCK=2
MEGA_PIN_HX711_DT=3
MEGA_PIN_HEATER_PREHEATER=6
MEGA_PIN_HEATER_LIQUID=8
MEGA_PIN_HEATER_GAS=9

# Arduino Uno / TB6600 pin map.
UNO_PIN_ENABLE=8
UNO_PIN_STEP=9
UNO_PIN_DIRECTION=10

# Both MCUs and the supervisor use the same heartbeat deadline.
MCU_HEARTBEAT_TIMEOUT_MS=3000

# A thermal trip cannot be reset until every monitored temperature is this
# many degrees below its configured high alarm threshold.
SAFETY_RESET_HYSTERESIS_C=2.0
