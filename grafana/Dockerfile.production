# Keep the human-readable patch tag and immutable multi-architecture digest.
FROM grafana/grafana:13.2.4@sha256:dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f

USER root
ENV GF_PATHS_PLUGINS=/var/lib/grafana-plugins
RUN install -d -o 472 -g 0 /var/lib/grafana-plugins \
    && grafana cli --pluginsDir /var/lib/grafana-plugins \
      plugins install frser-sqlite-datasource 4.0.6 \
    && test -f /var/lib/grafana-plugins/frser-sqlite-datasource/plugin.json \
    && chown -R 472:0 /var/lib/grafana-plugins
USER 472:0
