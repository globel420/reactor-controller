    {
      "id": 1,
      "title": "Reactor State",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "Reactor-SQLite"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "STANDBY": {
                  "color": "yellow",
                  "text": "STANDBY"
                },
                "HEATING": {
                  "color": "orange",
                  "text": "HEATING"
                },
                "HOLD": {
                  "color": "green",
                  "text": "HOLD"
                },
                "PURGE": {
                  "color": "blue",
                  "text": "PURGE"
                },
                "FAULT": {
                  "color": "red",
                  "text": "FAULT"
                },
                "EMERGENCY_STOP": {
                  "color": "dark-red",
                  "text": "E-STOP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "queryType": "table",
          "refId": "A",
          "queryText": "SELECT CASE control_state WHEN 0 THEN 'STANDBY' WHEN 1 THEN 'WARMUP' WHEN 2 THEN 'WORKING' ELSE 'UNKNOWN' END AS \"State\" FROM logs_1s ORDER BY timestamp DESC LIMIT 1"
        }
      ]
    },
