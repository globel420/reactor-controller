# This file becomes /etc/reactor-controller/reactor.env on the Raspberry Pi.
# The release builder replaces the three __...__ values before publication.
REACTOR_RELEASE_VERSION=__RELEASE_VERSION__
SUPERVISORY_IMAGE=__SUPERVISORY_IMAGE__
GRAFANA_IMAGE=__GRAFANA_IMAGE__

# New systems always start locked in commissioning mode. Use reactorctl after
# de-energized hardware verification to select hardware mode.
REACTOR_MODE=commissioning
REACTOR_DATA_DIR=/var/lib/reactor-controller
REACTOR_CONFIG_DIR=/etc/reactor-controller
REACTOR_UID=1000
REACTOR_GID=1000
SERIAL_DEVICE_GID=20

# Stable device paths created after explicit USB identity commissioning.
SENSOR_DEVICE_HOST=/dev/sensor_arduino
PUMP_DEVICE_HOST=/dev/pump_arduino
MEGA_USB_SERIAL=REPLACE_WITH_MEGA_SERIAL
UNO_USB_SERIAL=REPLACE_WITH_UNO_SERIAL
MEGA_USB_ID_PATH=
UNO_USB_ID_PATH=
MCU_IDENTITY_MODE=serial

# Accepted trusted-network deployment defaults. These credentials are replaced
# interactively by the installer and kept in root:reactor mode-0640 config.
HOTSPOT_SSID=Reactor-Rig
HOTSPOT_IPV4_CIDR=10.42.0.1/24
HOTSPOT_PSK=REPLACE_WITH_UNIQUE_WPA2_PASSWORD
ETHERNET_INTERFACE=eth0
WIFI_INTERFACE=wlan0
WIFI_SSID=
WIFI_PSK=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_GRAFANA_PASSWORD

# Host-side buzzer relay and persistent safety marker.
PI_BUZZER_GPIO=26
PI_BUZZER_ACTIVE_HIGH=true
PI_BUZZER_EXTERNAL_SAFE_PULL_CONFIRMED=false
ALLOW_MOCK_GPIO=false
HOST_SAFETY_LATCH_FILE=/var/lib/reactor-controller/supervisory/safety_latched

# Arduino Mega 2560 pin map. Hardware SPI remains on the Mega fixed pins 50-52.
MEGA_PIN_SPI_SCK=7
MEGA_PIN_SPI_MISO=5
MEGA_PIN_TC_FEED_RES=38
MEGA_PIN_TC_HOUSING=36
MEGA_PIN_RTD_PREHEATER=40
MEGA_PIN_RTD_LIQUID=42
MEGA_PIN_RTD_GAS_INT=44
MEGA_PIN_RTD_GAS_EXT=46
MEGA_PIN_H2_SENSOR=A0
MEGA_PIN_HX711_SCK=2
MEGA_PIN_HX711_DT=3
MEGA_PIN_HEATER_PREHEATER=6
MEGA_PIN_HEATER_LIQUID=8
MEGA_PIN_HEATER_GAS=9
MEGA_HEATER_ACTIVE_HIGH=1
MEGA_HEATER_EXTERNAL_SAFE_PULL_CONFIRMED=false

# Arduino Uno / TB6600 configuration.
UNO_PIN_ENABLE=8
UNO_PIN_STEP=9
UNO_PIN_DIRECTION=10
UNO_ENABLE_ACTIVE_LOW=1
UNO_ENABLE_EXTERNAL_SAFE_PULL_CONFIRMED=false

# This is changed only after the de-energized and low-energy commissioning
# checklist succeeds. Hardware mode remains blocked while it is false.
LOW_ENERGY_COMMISSIONING_COMPLETE=false

MCU_HEARTBEAT_TIMEOUT_MS=3000
SAFETY_RESET_HYSTERESIS_C=2.0
